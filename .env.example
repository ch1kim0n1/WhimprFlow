# Local development only. Copy values into your shell (or use .\dev.ps1 / ./dev.sh).
# Never commit a real .env with secrets.

# Windows: path to the folder that contains libclang.dll (whisper-rs / llama bindgen).
# Example after `winget install LLVM.LLVM`:
# LIBCLANG_PATH=C:\Program Files\LLVM\bin

# Do NOT set this on Windows MSVC builds. Linux pregenerated whisper bindings fail layout tests on MSVC.
# WHISPER_DONT_GENERATE_BINDINGS=1
